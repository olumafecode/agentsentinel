# Settings for docker compose. Copy this file to .env, which git ignores, and replace
# every value, or let the generator do it:  py tools/dev/make_env.py
#
# Use letters, digits, - and _ only, at least 32 characters each. The placeholders
# below are rejected on purpose, so the stack will not start until they are replaced.

# PostgreSQL superuser, used only to create the audit schema
POSTGRES_PASSWORD=replace-me
# The gateway's own database role, which can add audit rows but never change them
AUDIT_GATEWAY_DB_PASSWORD=replace-me
# Shared by the gateway and the bank to sign and check execution tokens (ADR-010)
EXECUTION_TOKEN_KEY=replace-me
# Signs customer session tokens; the gateway checks them (ADR-012)
SESSION_TOKEN_KEY=replace-me
# Vera's API key for the gateway
VERA_AGENT_KEY=replace-me
# Enables the bank's reset endpoint: py -m demo_bank_api reset
DEMO_ADMIN_KEY=replace-me
